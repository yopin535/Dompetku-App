rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Hanya user login yang boleh akses datanya sendiri.
    // Path: artifacts/dompetku-pribadi/users/{uid}/...
    match /artifacts/dompetku-pribadi/users/{uid}/{col}/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /artifacts/dompetku-pribadi/users/{uid}/{col} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Tolak selain path di atas secara default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
